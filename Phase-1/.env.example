# LLM (optional — pipeline and storefront coach use rule-based fallback if both are empty)
GROQ_API_KEY=
OPENAI_API_KEY=

# Storefront coach on :3000 calls Groq first (POST /api/coach/insights), then OpenAI.
# Keys stay on the Vite server. They are never sent to the browser.
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_MODEL=gpt-4o-mini

# Optional live sources
YOUTUBE_API_KEY=

# Collect UI
COLLECT_PORT=3001
REPORT_PORT=3001
